{
  "productName": "TeamLog",
  "version": "1.0.0",
  "identifier": "com.teamlog.desktop",
  "build": {
    "frontendDist": "frontend",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "TeamLog — 팀록",
        "width": 420,
        "height": 720,
        "minWidth": 360,
        "minHeight": 500,
        "alwaysOnTop": true,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "tooltip": "TeamLog — 팀록",
      "iconAsTemplate": true
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src https://couplogis.github.io https://api.telegram.org; img-src 'self' data: https:; font-src 'self' data:"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
